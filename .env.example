DRUPAL_PORT=8088

DB_NAME=drupal
DB_USER=drupal
DB_PASSWORD=change_this_local_password
DB_ROOT_PASSWORD=change_this_local_root_password

# Gov.br OpenID Connect. Keep disabled until the application is registered
# and homologated. Never commit real credentials.
GOVBR_ENABLED=false
GOVBR_ENVIRONMENT=staging
GOVBR_CLIENT_ID=
GOVBR_CLIENT_SECRET=
